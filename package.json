{
  "name": "inish-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Daily: nish.sh/daily front page served by a Cloudflare Worker (worker.js) with static assets. inish.in only redirects here.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test \"tests/**/*.test.mjs\" && python3 -m unittest discover -s tests"
  },
  "devDependencies": {
    "beasties": "0.5.4",
    "wrangler": "4.145.0"
  }
}
