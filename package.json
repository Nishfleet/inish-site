{
  "name": "aiconverter-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check:pricing": "node scripts/check-pricing.mjs",
    "dodo:sync-prices": "node scripts/sync-dodo-prices.mjs",
    "corpus:private": "node scripts/private-corpus.mjs",
    "stress:converters": "node scripts/stress-converters.mjs",
    "stress:checkout": "node scripts/stress-checkout-live.mjs",
    "drill:paid": "node scripts/paid-drill-live.mjs",
    "stress:live": "node scripts/stress-live.mjs",
    "smoke:preview": "node scripts/upload-preview-live.mjs",
    "monitor:live": "node scripts/monitor-live.mjs",
    "drill:failover": "node scripts/drill-failover-live.mjs",
    "readiness:live": "node scripts/readiness-live.mjs",
    "stress:all": "npm run stress:converters && npm run stress:live && npm run readiness:live",
    "release:gate": "npm run check:pricing && node --test tests/*.test.mjs && npm run corpus:private && npm audit --audit-level=moderate && npm run build && npm run stress:converters && npm run stress:live && AICONVERTER_MONITOR_STRICT=true npm run monitor:live && npm run readiness:live",
    "preview": "vite preview --host 0.0.0.0",
    "db:migrations:list": "wrangler d1 migrations list aiconverter --remote",
    "db:migrate:remote": "wrangler d1 migrations apply aiconverter --remote",
    "db:tables": "wrangler d1 execute aiconverter --remote --command \"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "hk-grotesk": "^1.0.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "unpdf": "^1.8.0",
    "vite": "^8.2.0"
  }
}
