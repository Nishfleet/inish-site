{
  "name": "inish-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nish’s Daily: nish.sh/daily front page served by a Cloudflare Worker (worker.js) with static assets. inish.in only redirects here.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "npm run build && cf dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test \"tests/**/*.test.mjs\" && python3 -m unittest discover -s tests",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@eslint/js": "10.0.1",
    "beasties": "0.5.5",
    "cf": "1.0.0-beta.28",
    "eslint": "10.14.0",
    "eslint-plugin-no-comments": "1.2.1",
    "globals": "17.14.0",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  }
}
