# Hourly Live current check on the VPS's own scheduler.
#
# GitHub's `schedule` events are delivered late or not at all for hours at a
# time (recurring on this repo since 2026-08-10, with 7+ hour silent gaps),
# so the hourly parity sweep cannot depend on the Actions scheduler. This
# timer fires reliably on the VPS; the Actions workflow remains as a manual
# dispatch path and a fallback, not the primary schedule.
#
# Matches the workflow's 0 * * * * (top of the hour, UTC). Offset from :00
# so the VPS sweep lands ~2 minutes after the GitHub one would have, keeping
# history comparable while never racing it (the check is read-only).

[Unit]
Description=Run the inish.in live-current parity check every hour

[Timer]
OnCalendar=*:2
Persistent=true
Unit=live-current-check.service

[Install]
WantedBy=timers.target
