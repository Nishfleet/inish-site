{
  "name": "inish-site",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  // Apex host patterns are required: "inish.in/*" alone does not match "/".
  "routes": [
    { "pattern": "inish.in", "zone_name": "inish.in" },
    { "pattern": "inish.in/*", "zone_name": "inish.in" },
    { "pattern": "www.inish.in", "zone_name": "inish.in" },
    { "pattern": "www.inish.in/*", "zone_name": "inish.in" }
  ],
  // `wrangler dev` presents requests as the first route's host; match the
  // live scheme so the worker's canonical-origin redirect stays quiet locally.
  "dev": { "upstream_protocol": "https" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*"],
    "html_handling": "none"
  }
}
