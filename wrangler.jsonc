{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aiconverter",
  "compatibility_date": "2026-05-12",
  "pages_build_output_dir": "dist",
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "AICONVERTER_BUCKET",
      "bucket_name": "aiconverter-private"
    }
  ],
  "d1_databases": [
    {
      "binding": "AICONVERTER_DB",
      "database_name": "aiconverter",
      "database_id": "376080eb-60f1-4bb8-aabb-06622acabb63"
    }
  ],
  "vars": {
    "AUTO_REFUNDS_ENABLED": "true",
    "CLOUDCONVERT_DAILY_JOB_LIMIT": "10",
    "CLOUDCONVERT_MIN_CREDITS": "1",
    "CLOUDCONVERT_REQUIRE_CREDIT_CHECK": "true",
    "ENABLE_AZURE_FALLBACK": "false",
    "FREE_DOWNLOADS_ENABLED": "false",
    "CONVERTIO_DAILY_JOB_LIMIT": "10",
    // Set RATE_LIMIT_SALT as a secret, not a committed var:
    // wrangler pages secret put RATE_LIMIT_SALT
    "RATE_LIMIT_MAX_PER_HOUR": "8"
  }
}
