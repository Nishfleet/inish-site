# /index.html -> / is intentionally absent here. The Worker (run_worker_first)
# redirects /index.html to / for real requests via the policy redirects map, so
# the rule never needs to fire from _redirects. Keeping it here would intercept
# the Worker's internal "/" -> "/index.html" asset fetch (html_handling: "none"
# needs that rewrite to serve the homepage) and 301 it back to "/", looping the
# root. _redirects is applied to env.ASSETS.fetch() calls, so it must omit this
# one redirect the Worker owns.
/daily / 301
/daily/ / 301
/daily/index.html / 301
/daily/app.js /app.js 301
/daily/styles.css /styles.css 301
/daily/latest.json /latest.json 301
/daily/feed.xml /feed.xml 301
/daily/sitemap.xml /sitemap.xml 301
/about /about.html 301
/privacy /privacy.html 301
/terms /terms.html 301
/contact /contact.html 301
