{
  "canonicalHost": "nish.sh",
  "dailyUrl": "https://nish.sh/daily",
  "pagePaths": ["/daily", "/daily/", "/daily/index.html"],
  "indexAsset": "/daily/index.html",
  "publicPaths": [
    "/daily/styles.css",
    "/daily/favicon.svg",
    "/daily/latest.json",
    "/daily/feed.xml",
    "/daily/fonts/fraunces-500.woff2",
    "/daily/fonts/fraunces-600.woff2",
    "/daily/fonts/newsreader.woff2",
    "/daily/fonts/newsreader-italic.woff2",
    "/daily/fonts/plex-mono-400.woff2",
    "/daily/fonts/OFL.txt"
  ],
  "hstsHeader": "max-age=31536000",
  "securityHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'none'; style-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
    "X-Frame-Options": "DENY"
  }
}
